/* 
==================================================================== 
                         Course Schedule II
==================================================================== 
 
Problem:
--------
There are numCourses courses numbered from 0 to numCourses - 1.

prerequisites[i] = [a, b] means:

b -> a

You must complete course b before taking course a.

Return a valid ordering of all courses.

If it is impossible to finish all courses, return an empty array.

==================================================================== 
Approach 1: DFS + Cycle Detection + Topological Sort
==================================================================== 
 
Idea:
-----
1. Create a directed graph.
2. Use DFS to detect a cycle.
3. Use visited to mark visited courses.
4. Use inrec to mark courses currently in the recursion path.
5. If we reach a course already in the recursion path, a cycle exists.
6. After visiting all neighbors, push the course into a stack.
7. Pop all courses from the stack to get the topological order.
8. If a cycle exists, return an empty array.

-------------------------------------------------------------------- 
Time Complexity:
-------------------------------------------------------------------- 
 
O(V + E)
 
-------------------------------------------------------------------- 
Space Complexity:
-------------------------------------------------------------------- 
 
O(V + E)
 
==================================================================== 
Code
==================================================================== 
*/

class Solution {
public: 

    bool dfscycle(
        int u,
        vector<bool>& visited,
        vector<vector<int>>& adj,
        stack<int>& st,
        vector<bool>& inrec
    )
    {
        visited[u] = true;
        inrec[u] = true;

        for(int v : adj[u])
        {
            if(!visited[v] && 
               dfscycle(v, visited, adj, st, inrec))
            {
                return true;
            }

            else if(inrec[v] == true)
            {
                return true;
            }
        }

        // Remove from current recursion path
        inrec[u] = false;

        // Push after processing all neighbors
        st.push(u);

        return false;
    }

    vector<int> findOrder(
        int numCourses,
        vector<vector<int>>& prerequisites
    ) {
        
        vector<vector<int>> adj(numCourses);

        // Create graph
        for(auto edge : prerequisites)
        {
            int u = edge[0];
            int v = edge[1];

            // v -> u
            adj[v].push_back(u);
        }

        vector<bool> visited(numCourses, false);
        vector<bool> inrec(numCourses, false);

        stack<int> st;

        for(int i = 0; i < numCourses; i++)
        {
            if(!visited[i] && 
               dfscycle(i, visited, adj, st, inrec))
            {
                return {};
            }
        }

        vector<int> ans;

        while(!st.empty())
        {
            ans.push_back(st.top());
            st.pop();
        }

        return ans;
    }
};

/* 
==================================================================== 
                         Course Schedule II
==================================================================== 
 
Problem:
--------
There are numCourses courses numbered from 0 to numCourses - 1.

prerequisites[i] = [a, b] means:

b -> a

You must complete course b before taking course a.

Return a valid ordering of all courses.

If it is impossible to finish all courses, return an empty array.

==================================================================== 
Approach 2: BFS (Kahn's Algorithm)
==================================================================== 
 
Idea:
-----
1. Create an adjacency list.
2. Calculate the indegree of every course.
3. Push all courses with indegree 0 into the queue.
4. Process courses using BFS.
5. Add every processed course to the answer.
6. Decrease the indegree of its dependent courses.
7. When indegree becomes 0, push that course into the queue.
8. If all courses are processed, return the answer.
9. Otherwise, a cycle exists, so return an empty array.

-------------------------------------------------------------------- 
Time Complexity:
-------------------------------------------------------------------- 
 
O(V + E)
 
-------------------------------------------------------------------- 
Space Complexity:
-------------------------------------------------------------------- 
 
O(V + E)
 
==================================================================== 
Code
==================================================================== 
*/

class Solution {
public: 

    vector<int> findOrder(
        int numCourses,
        vector<vector<int>>& prerequisites
    ) {
        
        vector<vector<int>> adj(numCourses);

        // Create graph
        for(auto edge : prerequisites)
        {
            int u = edge[0];
            int v = edge[1];

            // v -> u
            adj[v].push_back(u);
        }

        vector<int> indegree(numCourses, 0);

        // Calculate indegree
        for(int u = 0; u < numCourses; u++)
        {
            for(int &v : adj[u])
            {
                indegree[v]++;
            }
        }

        queue<int> q;

        // Courses with no prerequisites
        for(int i = 0; i < numCourses; i++)
        {
            if(indegree[i] == 0)
            {
                q.push(i);
            }
        }

        vector<int> ans;

        while(!q.empty())
        {
            int u = q.front();
            q.pop();

            ans.push_back(u);

            for(int v : adj[u])
            {
                indegree[v]--;

                if(indegree[v] == 0)
                {
                    q.push(v);
                }
            }
        }

        // Cycle exists
        if(ans.size() != numCourses)
            return {};

        return ans;
    }
};
