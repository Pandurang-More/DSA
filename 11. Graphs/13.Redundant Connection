/* 
==================================================================== 
                    Redundant Connection
==================================================================== 
 
Problem:
--------
Given a graph that started as a tree with n nodes and one additional
edge added, return the redundant edge that can be removed so that the
resulting graph becomes a tree.

If there are multiple answers, return the answer that occurs last in
the input.

-------------------------------------------------------------------- 
Approach: DFS
-------------------------------------------------------------------- 
 
Idea:
-----
Process each edge one by one.

Before adding an edge [u, v], check whether a path already exists
between u and v.

If a path already exists, adding this edge creates a cycle.
Therefore, this edge is redundant.

-------------------------------------------------------------------- 
Time Complexity:
-------------------------------------------------------------------- 
 
O(N²)
 
-------------------------------------------------------------------- 
Space Complexity:
-------------------------------------------------------------------- 
 
O(N)
 
==================================================================== 
Code
==================================================================== 
*/

class Solution {
public: 

    bool dfs(
        int u,
        int v,
        unordered_map<int, vector<int>>& adj,
        vector<bool>& visited
    )
    {
        visited[u] = true;
         
        if(u == v)
            return true;
         
        for(int neg : adj[u])
        {
            if(visited[neg])
                continue;

            if(dfs(neg, v, adj, visited))
                return true;
        }

        return false;
    }

    vector<int> findRedundantConnection(
        vector<vector<int>>& edges
    ) {
        
        unordered_map<int, vector<int>> adj;

        int n = edges.size();
      
        for(int i = 0; i < n; i++)
        {
            int u = edges[i][0];
            int v = edges[i][1];

            vector<bool> visited(n, false);

            if(
                adj.find(u) != adj.end() &&
                adj.find(v) != adj.end() &&
                dfs(u, v, adj, visited)
            )
            {
                return edges[i];
            }
            
            adj[u].push_back(v);
            adj[v].push_back(u);
        }

        return {};
    }
};
