/*
====================================================================
        Topological Sort of a Directed Acyclic Graph (DAG)
====================================================================

Problem:
--------
Given a Directed Acyclic Graph (DAG) with V vertices and E directed
edges, return a topological ordering of all vertices.

A topological ordering is a linear ordering such that for every
directed edge:

    u -> v

vertex u appears before vertex v in the ordering.

Note:

Topological sorting is possible only for a Directed Acyclic Graph
(DAG).

--------------------------------------------------------------------
Example 1:
--------------------------------------------------------------------

Input:
V = 4

edges = [[3,0],[1,0],[2,0]]

Possible Output:
[3,2,1,0]

Explanation:

For every directed edge:

3 -> 0
1 -> 0
2 -> 0

Vertices 3, 1, and 2 appear before vertex 0.

--------------------------------------------------------------------
Example 2:
--------------------------------------------------------------------

Input:
V = 6

edges = [
    [1,3],
    [2,3],
    [4,1],
    [4,0],
    [5,0],
    [5,2]
]

Possible Output:
[4,5,0,1,2,3]

====================================================================
Approach: DFS + Stack
====================================================================

Idea:
-----

Use DFS to traverse the graph.

For every vertex:

1. Mark it as visited.

2. Visit all its unvisited neighbors.

3. After visiting all neighbors, push the current vertex
   into the stack.

This ensures that a vertex is placed in the stack only after
all vertices reachable from it have been processed.

Finally, pop all elements from the stack.

The popped order gives a valid topological ordering.

Since the graph can have multiple components, start DFS
from every unvisited vertex.

Time Complexity:
----------------

O(V + E)

Space Complexity:
-----------------

O(V + E)

====================================================================
Code
====================================================================
*/

class Solution {
public:

    void dfs(vector<vector<int>>& adj,
             int u,
             vector<bool>& visited,
             stack<int>& st)
    {
        // Mark current node as visited
        visited[u] = true;

        // Visit all unvisited neighbors
        for(int v : adj[u])
        {
            if(!visited[v])
                dfs(adj, v, visited, st);
        }

        // Push node after processing all neighbors
        st.push(u);
    }


    vector<int> topoSort(int V, vector<vector<int>>& edges)
    {
        // Create adjacency list
        vector<vector<int>> adj(V);


        // Convert edges into adjacency list
        for(auto edge : edges)
        {
            int u = edge[0];
            int v = edge[1];

            // Directed edge: u -> v
            adj[u].push_back(v);
        }


        vector<bool> visited(V, false);

        stack<int> st;


        // Perform DFS for every component
        for(int i = 0; i < V; i++)
        {
            if(!visited[i])
                dfs(adj, i, visited, st);
        }


        // Stack contains reverse topological order
        vector<int> result;

        while(!st.empty())
        {
            result.push_back(st.top());
            st.pop();
        }

        return result;
    }
};
