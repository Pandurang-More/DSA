/*
====================================================================
                N-ary Tree Postorder Traversal
====================================================================

Definition:
-----------
An N-ary tree is a tree that can have more than 2 children.

/*
// Definition for a Node.
class Node {
public:
    int val;
    vector<Node*> children;

    Node() {}  // Create a Node with empty

    Node(int _val) {
        val = _val;    // Create a Node with value
    }

    Node(int _val, vector<Node*> _children) {        // create a Node with root+children
        val = _val;
        children = _children;
    }
};
*/

====================================================================
Approach: DFS (Recursive)
====================================================================

Idea:
-----
1. Visit all the children of the current node first.
2. After visiting every child, add the current node's value.
3. This follows the Left-to-Right Children → Root order,
   which is the definition of Postorder traversal.

Time Complexity:
----------------
O(N)

Space Complexity:
-----------------
O(H)
(H = Height of the tree due to recursion stack)

====================================================================
Code
====================================================================

class Solution {
public:

    void func(vector<int>& ans, Node* root)
    {
        // Visit all children first
        for(int i = 0; i < root->children.size(); i++)
        {
            func(ans, root->children[i]);
        }

        // Then visit the current node
        ans.push_back(root->val);
    }

    vector<int> postorder(Node* root)
    {
        vector<int> ans;

        if(!root)
            return ans;

        func(ans, root);

        return ans;
    }
};

