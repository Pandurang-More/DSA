/*
====================================================================
                    572. Subtree of Another Tree
====================================================================

Problem:
--------
Given the roots of two binary trees root and subRoot, return true if
there is a subtree of root with the same structure and node values of
subRoot and false otherwise.

A subtree of a binary tree tree is a tree that consists of a node in
tree and all of this node's descendants.

The tree tree could also be considered as a subtree of itself.

--------------------------------------------------------------------
Example 1:
--------------------------------------------------------------------

Input:
root = [3,4,5,1,2]
subRoot = [4,1,2]

Output:
true

--------------------------------------------------------------------
Example 2:
--------------------------------------------------------------------

Input:
root = [3,4,5,1,2,null,null,null,null,0]
subRoot = [4,1,2]

Output:
false

--------------------------------------------------------------------
Constraints:
--------------------------------------------------------------------

The number of nodes in the root tree is in the range [1, 2000].

The number of nodes in the subRoot tree is in the range [1, 1000].

-10^4 <= root.val <= 10^4

-10^4 <= subRoot.val <= 10^4

====================================================================
Approach: Recursive DFS
====================================================================

Idea:
-----
1. Use isidentical() to check whether two trees are exactly the same.
2. Traverse every node of root.
3. If the current node's value is equal to subRoot's root value,
   check whether both trees are identical.
4. If not, search for subRoot in the left and right subtrees.

====================================================================
Code
====================================================================

class Solution
{
public:

    bool isidentical(TreeNode* root, TreeNode* subRoot)
    {
        if(root == NULL || subRoot == NULL)
        {
            return root == subRoot;
        }

        return root->val == subRoot->val
            && isidentical(root->left, subRoot->left)
            && isidentical(root->right, subRoot->right);
    }

    bool isSubtree(TreeNode* root, TreeNode* subRoot)
    {
        if(root == NULL || subRoot == NULL)
        {
            return root == subRoot;
        }

        if(root->val == subRoot->val &&
           isidentical(root, subRoot))
        {
            return true;
        }

        return isSubtree(root->left, subRoot)
            || isSubtree(root->right, subRoot);
    }
};

====================================================================
Complexity
====================================================================

Time Complexity:
----------------
O(N × M)

N = Number of nodes in root
M = Number of nodes in subRoot

Space Complexity:
-----------------
O(H)

H = Height of the tree due to recursion.

====================================================================
