/*
====================================================================
                Convert Sorted Array to Binary Search Tree
====================================================================

Problem:
--------
Given an integer array nums where the elements are sorted in ascending
order, convert it to a height-balanced binary search tree.

--------------------------------------------------------------------
Example 1:
--------------------------------------------------------------------

Input:
nums = [-10,-3,0,5,9]

Output:
[0,-3,9,-10,null,5]

Explanation:
[0,-10,5,null,-3,null,9] is also accepted.

--------------------------------------------------------------------
Example 2:
--------------------------------------------------------------------

Input:
nums = [1,3]

Output:
[3,1]

Explanation:
[1,null,3] and [3,1] are both height-balanced BSTs.

--------------------------------------------------------------------
Constraints:
--------------------------------------------------------------------

1 <= nums.length <= 10^4

-10^4 <= nums[i] <= 10^4

nums is sorted in a strictly increasing order.

====================================================================
Approach: Divide and Conquer
====================================================================

Idea:
-----
Since the array is sorted, choose the middle element as the root.

1. Find the middle element.
2. Create a node using the middle element.
3. Recursively construct the left subtree using the left half.
4. Recursively construct the right subtree using the right half.
5. Return the root.

Choosing the middle element keeps the tree height-balanced.

Time Complexity:
----------------
O(N)

Space Complexity:
-----------------
O(log N)

(O(log N) recursion stack for a balanced tree.)

====================================================================
Code
====================================================================

class Solution {
public:

    TreeNode* BST(vector<int>& nums, int start, int end)
    {
        if(start > end)
            return NULL;

        int mid = start + (end - start) / 2;

        TreeNode* root = new TreeNode(nums[mid]);

        root->left = BST(nums, start, mid - 1);
        root->right = BST(nums, mid + 1, end);

        return root;
    }

    TreeNode* sortedArrayToBST(vector<int>& nums)
    {
        int start = 0;
        int end = nums.size() - 1;

        return BST(nums, start, end);
    }
};

====================================================================
