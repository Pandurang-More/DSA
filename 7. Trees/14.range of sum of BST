/*
====================================================================
                    Range Sum of BST
====================================================================

Problem:
--------
Given the root node of a binary search tree and two integers low and
high, return the sum of values of all nodes with a value in the
inclusive range [low, high].

--------------------------------------------------------------------
Example 1:
--------------------------------------------------------------------

Input:
root = [10,5,15,3,7,null,18]
low = 7
high = 15

Output:
32

Explanation:
Nodes 7, 10, and 15 are in the range [7, 15].

7 + 10 + 15 = 32.

--------------------------------------------------------------------
Example 2:
--------------------------------------------------------------------

Input:
root = [10,5,15,3,7,13,18,1,null,6]
low = 6
high = 10

Output:
23

Explanation:
Nodes 6, 7, and 10 are in the range [6, 10].

6 + 7 + 10 = 23.

--------------------------------------------------------------------
Constraints:
--------------------------------------------------------------------

The number of nodes in the tree is in the range [1, 2 * 10^4].

1 <= Node.val <= 10^5

1 <= low <= high <= 10^5

All Node.val are unique.

====================================================================
Approach 1: With Extra Space
====================================================================

Idea:
-----
1. Perform an inorder traversal of the BST.
2. Store all node values in a vector.
3. Traverse the vector and add values that are within [low, high].

Since inorder traversal of a BST gives values in sorted order,
the values in the vector are sorted.

Time Complexity:
----------------
O(N)

Space Complexity:
-----------------
O(N)

====================================================================
Code
====================================================================

class Solution {
public:

    void inorder(TreeNode* root, vector<int>& ans)
    {
        if(root != NULL)
        {
            inorder(root->left, ans);

            ans.push_back(root->val);

            inorder(root->right, ans);
        }
    }

    int rangeSumBST(TreeNode* root, int low, int high)
    {
        vector<int> ans;

        inorder(root, ans);

        int sum = 0;

        for(int val : ans)
        {
            if(val >= low && val <= high)
                sum += val;
        }

        return sum;
    }
};

====================================================================
Approach 2: Without Extra Space
====================================================================

Idea:
-----
Traverse the tree recursively.

For every node:

1. If the node's value is within [low, high], add it to sum.
2. Recursively check the left subtree.
3. Recursively check the right subtree.

Time Complexity:
----------------
O(N)

Space Complexity:
-----------------
O(H)

where H is the height of the tree due to recursion.

====================================================================
Code
====================================================================

class Solution {
public:

    int rangeSumBST(TreeNode* root, int low, int high)
    {
        if(root == NULL)
            return 0;

        int sum = 0;

        if(root->val >= low && root->val <= high)
        {
            sum += root->val;
        }

        sum += rangeSumBST(root->left, low, high);

        sum += rangeSumBST(root->right, low, high);

        return sum;
    }
};

====================================================================
