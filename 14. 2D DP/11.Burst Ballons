/*
====================================================================
                            Burst Balloons
====================================================================

Problem:
--------
You are given n balloons, indexed from 0 to n - 1. Each balloon is
painted with a number on it represented by an array nums.

You are asked to burst all the balloons.

If you burst the ith balloon, you will get:

nums[i - 1] * nums[i] * nums[i + 1]

coins.

If i - 1 or i + 1 goes out of bounds of the array, then treat it as
if there is a balloon with a 1 painted on it.

Return the maximum coins you can collect by bursting the balloons
wisely.

--------------------------------------------------------------------
Example 1:
--------------------------------------------------------------------

Input:
nums = [3,1,5,8]

Output:
167

Explanation:

nums = [3,1,5,8]
     --> [3,5,8]
     --> [3,8]
     --> [8]
     --> []

coins =
3*1*5 + 3*5*8 + 1*3*8 + 1*8*1 = 167

--------------------------------------------------------------------
Example 2:
--------------------------------------------------------------------

Input:
nums = [1,5]

Output:
10

--------------------------------------------------------------------
Constraints:
--------------------------------------------------------------------

n == nums.length

1 <= n <= 300

0 <= nums[i] <= 100

====================================================================
Approach: Bottom-Up Interval DP
====================================================================

Idea:
-----
Add 1 at both ends of the array.

For every interval [left, right], assume that balloon k is the LAST
balloon to be burst inside this interval.

Then:

    dp[left][k]
    
represents the maximum coins from the left part.

    dp[k][right]
    
represents the maximum coins from the right part.

When k is burst last, its neighbors are nums[left] and nums[right],
so the coins obtained are:

    nums[left] * nums[k] * nums[right]

Therefore:

    dp[left][right] =
        max(
            dp[left][k] +
            dp[k][right] +
            nums[left] * nums[k] * nums[right]
        )

Time Complexity:
----------------
O(N³)

Space Complexity:
-----------------
O(N²)

====================================================================
Code
====================================================================

class Solution {
public:

    int maxCoins(vector<int>& nums)
    {
        int n = nums.size();

        nums.insert(nums.begin(), 1);
        nums.push_back(1);

        vector<vector<int>> dp(n + 2, vector<int>(n + 2, 0));

        for(int len = 2; len < n + 2; len++)
        {
            for(int left = 0; left + len < n + 2; left++)
            {
                int right = left + len;

                for(int k = left + 1; k < right; k++)
                {
                    dp[left][right] = max(
                        dp[left][right],
                        dp[left][k] +
                        dp[k][right] +
                        nums[left] * nums[k] * nums[right]
                    );
                }
            }
        }

        return dp[0][n + 1];
    }
};

====================================================================
